# 複製成 .env 後填入。.env 不進 git。

# Discord Developer Portal → Bot → Reset Token
DISCORD_BOT_TOKEN=

# Control UI 登入用，產生方式：openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=

# Control UI 在主機上的 port（只綁 127.0.0.1）
OPENCLAW_GATEWAY_PORT=18789

# fbwatch 唯讀 MCP 的 token，要跟 fbwatch 的 .env 裡 FBWATCH_MCP_TOKEN 同一個值
FBWATCH_MCP_TOKEN=

# Hub bot（#agent-hub）用的 Agent Hub 設定
HUB_URL=http://<hub-host>:8787
HUB_REMOTE_TOKEN_FILE=/path/to/agent-hub/data/remote-token
HUB_REPOS=agent-hub=/path/to/agent-hub
HUB_MCP_TOKEN=
HUB_NOTIFY_WEBHOOK=
HUB_NOTIFY_BOT_ID=

# 選填：第二個 bot（另一個 Discord application），給另一個聊天室用
DISCORD_SECOND_BOT_TOKEN=
